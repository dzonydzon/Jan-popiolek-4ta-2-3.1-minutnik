<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="okno.MainWindow"
        Title="Minutnik"
        Width="560" Height="520"
        MinWidth="460" MinHeight="480"
        Background="#F3F5F2">
    <Grid Margin="32" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="22">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="3">
                <TextBlock Text="MINUTNIK" FontSize="13" FontWeight="Bold" Foreground="#66716A" />
                <TextBlock Text="Rytm pracy" FontSize="25" FontWeight="SemiBold" Foreground="#202923" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E3E9E3" CornerRadius="6" Padding="11,7">
                <TextBlock Text="POMODORO" FontSize="11" FontWeight="Bold" Foreground="#435248" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="24">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border x:Name="PhaseIndicator" Width="9" Height="9" CornerRadius="5" Background="#D5684C" />
                    <TextBlock x:Name="PhaseText" Text="PRACA" FontSize="14" FontWeight="Bold" Foreground="#46534A" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="25:00" FontSize="76" FontWeight="Bold"
                               Foreground="#202923" VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Border Grid.Column="2" BorderBrush="#E4E9E4" BorderThickness="1,0,0,0"
                            Padding="22,0,0,0" VerticalAlignment="Center">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="CycleCountText" Text="00" FontSize="30"
                                       FontWeight="SemiBold" Foreground="#202923" />
                            <TextBlock Text="CYKLE" FontSize="11" FontWeight="Bold"
                                       Foreground="#78837B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Praca (min)" FontSize="13" Foreground="#4D5A51" />
                <NumericUpDown x:Name="WorkDurationInput" Minimum="1" Maximum="180"
                                Increment="1" Value="25" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Przerwa (min)" FontSize="13" Foreground="#4D5A51" />
                <NumericUpDown x:Name="BreakDurationInput" Minimum="1" Maximum="180"
                                Increment="1" Value="5" FormatString="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button x:Name="StartPauseButton" Content="Start" Click="OnStartPauseClick"
                    Height="48" FontSize="16" FontWeight="SemiBold"
                    Background="#D5684C" Foreground="White" />
            <Button Grid.Column="1" Content="Resetuj" Click="OnResetClick"
                    Height="48" MinWidth="112" FontSize="15"
                    Background="#E3E9E3" Foreground="#26332A" />
        </Grid>
    </Grid>
</Window>
